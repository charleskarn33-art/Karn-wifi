# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key -- SERVER ONLY, never expose to the browser.
# Used only for privileged admin operations (creating users with a role).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: app-wide currency/locale formatting
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US

# Public site URL (used for auth redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
